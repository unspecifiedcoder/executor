# Only these are read by code that runs. Everything else that used to be listed
# here (Circle, Chainlink CRE, The Graph, Bazantic, Key Ring, Hedera ATS) served
# integrations that were never built.

# --- Dashboard write routes ---
# apps/dashboard/lib/chain-actions.server.ts reads this. Needs a funded Sepolia
# key; it signs enterAdministration() / restoreActive() for the shared demo
# agent. Put it in apps/dashboard/.env.local, not here - Next only loads env
# files from the app directory.
# The dashboard's READ paths need nothing: they use a public Sepolia RPC.
OPERATOR_PRIVATE_KEY=

# --- Hedera testnet ---
# The paying client, packages/agent-debtor/src/pay-for-research.ts.
# The gateway itself needs no key: it only quotes a destination, the
# facilitator settles.
HEDERA_PRIVATE_KEY=

# --- Foundry scripts (optional) ---
# Only needed if you run anything under contracts/script/. Nothing in the
# running demo requires it.
SEPOLIA_RPC_URL=
